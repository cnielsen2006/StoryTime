# --- Server ---
PORT=3001
HOST=127.0.0.1
# Set HOST=0.0.0.0 to expose the app on your LAN
DB_PATH=./data/storytime.db

# --- LLM provider defaults (can be overridden per project in the UI) ---
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=
DEFAULT_EFFORT=high

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Reroute safety refusals to a fallback model automatically. "default" | "off"
ANTHROPIC_FALLBACKS=default

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Ollama (local models) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
